# Required for OpenAQ v3 air-quality data. Never expose this value in browser code.
OPENAQ_API_KEY=

# Optional; hosting platforms usually assign this automatically.
PORT=3001

# Set to 1 when the app is behind a single trusted reverse proxy (for example Render).
TRUST_PROXY_HOPS=0

# Optional MET Norway identification. Defaults to the public CityPulse repository URL.
METNO_USER_AGENT=CityPulse/1.0 (https://github.com/yohanNonghee/Connecting-to-the-world)
